# Copy this file to .env and fill in your own value. Never commit .env.
#
# In Supabase, click Connect and copy the "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password. If the password holds
# symbols such as @ or /, percent-encode them.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
