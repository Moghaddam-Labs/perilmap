# Copy to .env.local to change these while developing. Nothing here is secret: anything starting
# NEXT_PUBLIC_ is sent to visitors' browsers, so never put a password or key in this file.

# Where the website finds the API. Leave out to use the live API.
# NEXT_PUBLIC_PERILMAP_API_URL=http://127.0.0.1:8000

# Shows the design system page at /design on a production build. It's always on under npm run dev.
# PERILMAP_SHOW_DESIGN_PAGE=true
