{
  "name": "perilmap-web",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-map-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "bezel-charts": "github:ShazMoghaddam/bezel-charts#v1.1.0",
    "maplibre-gl": "6.17.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    }
  }
}
